aws_region   = "ap-south-1"
project_name = "devops-mini-project"

# Restrict Jenkins to your own IP:  curl ifconfig.me  -> "1.2.3.4/32"
admin_cidr = "0.0.0.0/0"

# Optional SSH key pair (must already exist in the region). Empty = use SSM only.
jenkins_key_name = ""

create_jenkins        = true
jenkins_instance_type = "t3.small"
app_desired_count     = 2
